{
  "name": "miszt-studio",
  "productName": "Miszt Studio",
  "version": "0.8.0",
  "private": true,
  "description": "Editor de vídeo com áudio de nível DAW",
  "author": "Miszt",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@huggingface/transformers": "^4.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.25.12": true,
    "onnxruntime-node": false,
    "protobufjs": false
  },
  "build": {
    "appId": "com.miszt.studio",
    "productName": "Miszt Studio",
    "copyright": "Miszt",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "src/dsp/*.js",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "electron/separate.py",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**",
      "electron/vst.py"
    ],
    "fileAssociations": [
      {
        "ext": "edproj",
        "name": "Projeto do Miszt Studio",
        "description": "Projeto do Miszt Studio",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Miszt Studio",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "MisztStudio-Setup-${version}.${ext}",
      "license": "LICENSE"
    },
    "electronDist": "node_modules/electron/dist",
    "publish": [
      {
        "provider": "github",
        "owner": "misztliszt",
        "repo": "misztstudio",
        "releaseType": "release"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/misztliszt/misztstudio.git"
  }
}
